# ─── LLM ────────────────────────────────────────────────────────────────────
# Mistral (por defecto). Cambiar a OLLAMA si se requiere usar un modelo local.
MISTRAL_API_KEY=tu_clave_aqui
MISTRAL_MODEL=mistral-small-latest

# Ollama (opcional, descomenta si usas local)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_LLM_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── RAG ────────────────────────────────────────────────────────────────────
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVER_K=4
MIN_SCORE=0.35
MAX_CONTEXT_CHARS=6000
LLM_TEMPERATURE=0.1
LLM_TOP_K=10
LLM_TOP_P=0.9

# ─── SCRAPING ────────────────────────────────────────────────────────────────
SCRAPE_CONCURRENCY=4
SCRAPE_TIMEOUT_S=20
SCRAPE_DELAY_MIN=1.5
SCRAPE_DELAY_MAX=4.0
SCRAPE_MAX_PAGES=200

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
EXPERIMENT_NAME=recamier-chatbot-rag

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ─── LangSmith (opcional) ────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recamier-chatbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
